<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ config.title }}</title>
<style>
  :root { color-scheme: light; }
  body { margin: 0; padding: 32px; font: 15px/1.55 "Segoe UI", system-ui, sans-serif;
         color: #1f2933; background: #ffffff; max-width: 1100px; }
  h1 { font-size: 26px; margin: 0 0 8px; }
  h2 { font-size: 19px; margin: 32px 0 10px; padding-bottom: 6px;
       border-bottom: 1px solid #e2e8f0; }
  h3 { font-size: 15px; margin: 20px 0 8px; color: #334155; }
  .meta { color: #475569; font-size: 13px; margin: 0 0 4px; }
  .meta code { background: #f1f5f9; padding: 1px 5px; border-radius: 4px; }
  table { border-collapse: collapse; width: 100%; margin: 8px 0 16px; font-size: 13.5px; }
  th, td { border: 1px solid #e2e8f0; padding: 6px 9px; text-align: left; }
  th { background: #f8fafc; font-weight: 600; }
  td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
  code { font-family: "Cascadia Mono", Consolas, monospace; font-size: 12.5px; }
  img { max-width: 100%; height: auto; border: 1px solid #e2e8f0; border-radius: 6px; }
  ul.conclusions { list-style: none; padding: 0; }
  ul.conclusions li { margin: 6px 0; padding: 8px 12px; border-radius: 6px;
                      border-left: 4px solid #94a3b8; background: #f8fafc; }
  li.level-ok { border-left-color: #16a34a; background: #f0fdf4; }
  li.level-warn { border-left-color: #d97706; background: #fffbeb; }
  li.level-fail { border-left-color: #dc2626; background: #fef2f2; }
  .badge { font-weight: 700; font-size: 11px; letter-spacing: .04em; }
  footer { margin-top: 40px; padding-top: 12px; border-top: 1px solid #e2e8f0;
           color: #64748b; font-size: 12px; }
</style>
</head>
<body>
<h1>{{ config.title }}</h1>
<p class="meta">Прогон <code>{{ data.run_id }}</code> ({{ data.kind }}) · статус {{ data.run.status }}</p>
<p class="meta">Начат {{ data.run.started_at }} · завершён {{ data.run.finished_at or "—" }}</p>
<p class="meta">Отчёт {{ config.report_id }} · сформирован {{ data.generated_at }}
{%- if data.app_version %} · версия {{ data.app_version }}{% endif %}
{%- if data.project_hash %} · проект <code>{{ data.project_hash }}</code>{% endif %}</p>

{% if "metadata" in config.sections %}
<h2>1. Метаданные прогона</h2>
<table>
  <tr><th>Поле</th><th>Значение</th></tr>
  <tr><td>Идентификатор</td><td><code>{{ data.run_id }}</code></td></tr>
  <tr><td>Вид</td><td>{{ data.kind }}</td></tr>
  <tr><td>Статус</td><td>{{ data.run.status }}</td></tr>
  <tr><td>Seed</td><td>{{ data.run.seed if data.run.seed is not none else "—" }}</td></tr>
  <tr><td>Объект</td><td>{{ data.run.pipeline_id or data.run.mission_id or data.run.exercise_id or "—" }}</td></tr>
  <tr><td>Событий</td><td class="num">{{ data.events }}</td></tr>
  <tr><td>Метрик</td><td class="num">{{ data.series | length }}</td></tr>
  <tr><td>Артефактов</td><td class="num">{{ data.artifacts | length }}</td></tr>
  {% if data.run.reason %}<tr><td>Причина</td><td>{{ data.run.reason }}</td></tr>{% endif %}
</table>
{% endif %}

{% if "config" in config.sections and data.run.config %}
<h2>2. Конфигурация прогона</h2>
<table>
  <tr><th>Параметр</th><th>Значение</th></tr>
  {% for key, value in data.run.config | dictsort %}
  <tr><td><code>{{ key }}</code></td><td>{{ value }}</td></tr>
  {% endfor %}
</table>
{% endif %}

{% if "metrics" in config.sections and metrics %}
<h2>3. Метрики</h2>
<table>
  <tr><th>Метрика</th><th>Ед.</th><th class="num">Значений</th><th class="num">Среднее</th>
      <th class="num">p50</th><th class="num">p95</th><th class="num">Максимум</th></tr>
  {% for item in metrics %}
  <tr><td><code>{{ item.name }}</code></td><td>{{ item.unit or "—" }}</td>
      <td class="num">{{ item.count }}</td><td class="num">{{ item.mean }}</td>
      <td class="num">{{ item.p50 }}</td><td class="num">{{ item.p95 }}</td>
      <td class="num">{{ item.max }}</td></tr>
  {% endfor %}
</table>
{% endif %}

{% if "plots" in config.sections and plots %}
<h2>4. Графики</h2>
{% for plot in plots %}
<h3>{{ plot.title }}</h3>
<img src="{{ plot.data_uri }}" alt="{{ plot.title }}" width="{{ plot.width }}" height="{{ plot.height }}">
{% endfor %}
{% endif %}

{% if "scale" in config.sections and (stages or scale) %}
<h2>5. Масштаб времени и план/факт</h2>
{% if scale %}
<table>
  <tr><th>Показатель</th><th class="num">Значение</th></tr>
  {% for row in scale %}
  <tr><td>{{ row.name }}</td><td class="num">{{ row.value }} {{ row.unit or "" }}</td></tr>
  {% endfor %}
</table>
{% endif %}
{% if stages %}
<table>
  <tr><th>Ступень</th><th class="num">План, мс</th><th class="num">p50, мс</th>
      <th class="num">p95, мс</th><th class="num">Максимум, мс</th>
      <th class="num">Перерасход, мс</th><th class="num">Отношение</th></tr>
  {% for item in stages %}
  <tr><td>{{ item.stage }}</td><td class="num">{{ item.plan_ms }}</td>
      <td class="num">{{ item.actual_p50_ms }}</td><td class="num">{{ item.actual_p95_ms }}</td>
      <td class="num">{{ item.actual_max_ms }}</td><td class="num">{{ item.overrun_ms }}</td>
      <td class="num">{{ item.ratio }}</td></tr>
  {% endfor %}
</table>
{% endif %}
{% endif %}

{% if "conclusions" in config.sections and conclusions %}
<h2>6. Выводы</h2>
<ul class="conclusions">
  {% for item in conclusions %}
  <li class="level-{{ item.level }}"><span class="badge">{{ item.level | upper }}</span> — {{ item.text }}</li>
  {% endfor %}
</ul>
{% endif %}

{% if artifacts %}
<h2>Артефакты</h2>
<table>
  <tr><th>Вид</th><th>Файл</th><th>Хэш</th></tr>
  {% for item in artifacts %}
  <tr><td>{{ item.kind }}</td><td><code>{{ item.path }}</code></td><td>{{ item.hash or "—" }}</td></tr>
  {% endfor %}
</table>
{% endif %}

<footer>simorph · отчёт {{ config.report_id }} · автономный документ без внешних ресурсов</footer>
</body>
</html>
